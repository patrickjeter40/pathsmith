{
  "formatVersion": "0.1",
  "id": "gaming_content_scenarios",
  "name": "Gaming content synthetic scenarios",
  "description": "Authored policy expectations for four channels and ordered threshold routes; these are not observed production labels.",
  "scenarios": [
    {
      "id": "chat_abuse",
      "name": "chat abuse",
      "tags": [
        "synthetic",
        "in_game_chat"
      ],
      "input": {
        "channel": "in_game_chat",
        "content": "You are worthless. I will keep harassing you every match."
      },
      "expected": {
        "allowedOutcomes": [
          "risk_review"
        ],
        "requiredNodes": [
          "assess_content",
          "prepare_annotations",
          "route_content",
          "out_risk_review"
        ],
        "assertions": [
          {
            "op": "eq",
            "left": {
              "op": "ref",
              "path": [
                "result",
                "value",
                "queue"
              ]
            },
            "right": {
              "op": "literal",
              "value": "trust_safety"
            }
          },
          {
            "op": "eq",
            "left": {
              "op": "ref",
              "path": [
                "result",
                "value",
                "requiresReview"
              ]
            },
            "right": {
              "op": "literal",
              "value": true
            }
          },
          {
            "op": "eq",
            "left": {
              "op": "ref",
              "path": [
                "result",
                "value",
                "annotations",
                "category"
              ]
            },
            "right": {
              "op": "literal",
              "value": "abuse"
            }
          },
          {
            "op": "eq",
            "left": {
